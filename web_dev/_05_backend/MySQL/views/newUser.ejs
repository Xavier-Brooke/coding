<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style/newUser.css">
    <title>newUser</title>
</head>
<body>
    <h2>Create Your Account</h2>
    <form method="post" action="/insta">
        <div class="name">
            <label for="name">Enter your name :- </label>
            <input type="text" id="name" name="users[name]" required placeholder="Enter your name" maxlength="50" minlength="3">
        </div>
        <div class="age">
            <label for="age">Enter your age :- </label>
            <input type="number" id="age" name="users[age]" required placeholder="Enter your age" max="60" min="15" step="1">
        </div>
        <div class="email">
            <label for="email">Enter your email :- </label>
            <input type="email" id="email" name="users[email]" required placeholder="Enter your email" maxlength="50">
        </div>
        <div class="password">
            <label for="password">Enter your password :- </label>
            <input type="text" id="password" name="users[password]" required placeholder="Enter your password" maxlength="50">
        </div>
        <div class="city">
            <label for="city">Enter your city :- </label>
            <input type="text" id="city" name="users[city]" required placeholder="Enter your city" maxlength="50">
        </div>
        <div class="coutry">
            <label for="coutry">Enter your country :- </label>
            <input type="text" id="country" name="users[country]" required placeholder="Enter your county" maxlength="50">
        </div>
        <div class="btns">
            <button type="reset">Reset</button> &emsp; <button type="submit">Submit</button>
            &emsp;
            <button type="button" onclick="location.href='/insta/'">Home</button>
        </div>
    </form>
</body>
</html>