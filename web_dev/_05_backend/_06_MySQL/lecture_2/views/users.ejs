<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>users</title>
</head>
<body>

    <h1>
        <i>
            All users
            &emsp;
            <form method="get" action="/api" style="display: inline;"><button>Home</button></form>
            &emsp;
            <form method="get" action="/api/newUser" style="display: inline;"><button>New user</button></form>
        </i>
    </h1>
    
    <table border="black">
        <tr>
            <th rowspan="2">ID</th>
            <th rowspan="2">userName</th>
            <th rowspan="2">email</th>
            <th rowspan="2">msg</th>
            <th colspan="3">Functionalities</th>
        </tr>
        <tr>
            <th>Details</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
        <% for(let user of users) {%>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.userName%></td>
                <td><%= user.email %></td>
                <td><%= user.msg %></td>
                <td><form method="get" action="/api/<%= user.id %>/details" style="display: inline;"><button>Details</button></form></td>
                <td><form method="get" action="/api/<%= user.id %>/edit" style="display: inline;"><button>Edit</button></form></td>
                <td><form method="get" action="/api/<%= user.id %>/delete" style="display: inline;"><button>Delete</button></form></td>
            </tr>
        <% } %>
    </table>
</body>
</html>