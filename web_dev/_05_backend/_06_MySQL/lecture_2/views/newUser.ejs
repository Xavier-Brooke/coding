<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>newUser</title>
</head>
<body>

    <h1><i>Become our user</i></h1>

    <form method="post" action="/api">

        <label for="userName">Enter your userName :- </label>
        <input type="text" id="userName" name="userName" required maxlength="50" placeholder="Enter your userName here!">
        <br><br>

        <label for="email">Enter your email :- </label>
        <input type="email" id="email" name="email" required maxlength="50" placeholder="Enter your email here!">
        <br><br>

        <label for="password">Enter your password :- </label>
        <input type="password" id="password" name="password" required maxlength="50" placeholder="Enter your password here!">
        <br><br>

        <textarea name="msg" placeholder="Enter your msg here!" maxlength="50" required cols="35" rows="5"></textarea>
        <br><br>

        <button onclick="location.href='/api'">Home</button> <button type="reset">Rest</button>    <button>Submit</button>
    </form>
</body>
</html>