<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>newChat</title>
</head>
<body>
    <h2>Create New Chat</h2>
    <form method="post" action="/chats">
        <label for="name">Enter your name :- </label>
        <input type="text" id="name" name="name" required placeholder="Enter your name" maxlength="50">
        <br><br>
        <label for="password">Enter your password :- </label>
        <input type="password" id="password" name="password" required placeholder="Enter your password" maxlength="50">
        <br><br>
        <label for="email">Enter your emial</label>
        <input type="email" id="email" name="email" required placeholder="adam@gmail.com" maxlength="50">
        <br><br>
        <button type="reset">Reset</button> &emsp; <button type="submit">Submit</button>
    </form>
    <br>
    <button type="button" onclick="location.href='/'">Back</button>
</body>
</html>