<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit</title>
</head>
<body>
    <h2>Edit your post</h2>
    <form method="post" action="/chats/<%= userData.id %>?_method=PATCH">
        <label for="name">Edit your name :- </label>
        <input type="text" id="name" name="name" required value="<%= userData.name %>" maxlength="50">
        <br><br>
        <label for="password">Edit your password :- </label>
        <input type="password" id="password" name="password" required value="<%= userData.name %>" maxlength="50">
        <br><br>
        <label for="email">Edit your emial</label>
        <input type="email" id="email" name="email" required value="<%= userData.email %>" maxlength="50">
        <br><br>
        <button type="reset">Reset</button> &emsp; <button type="submit">Submit</button>
    </form>
    <br>
    <button type="button" onclick="location.href='/chats'">Back</button>
</body>
</html>