<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Details</title>
</head>
<body>
    <h1><i>Your post in details</i></h1>
    <form method="get" action="/api">

        <label for="id">id :- </label>
        <input type="text" id="id" readonly value="<%= user.id %>" size="<%= (user.id).length %>">
        <br><br>

        <label for="name">userName :- </label>
        <input type="text" id="name" readonly value="<%= user.name %>">
        <br><br>

        <textarea cols="38" rows="5" readonly><%= user.msg %></textarea>
        <br><br>

        <label for="date">posted at :- </label>
        <input readonly value="<%= day %> (<%= time %>)" id="date">

        <button>Back</button>
    </form>
</body>
</html>