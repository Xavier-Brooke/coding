<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit</title>
</head>
<body>

    <h1><i>Your post in details</i></h1>
    <form method="post" action="/api/<%= id %>?_method=PATCH">

        <label for="name">userName :- </label>
        <input type="text" id="name" name="name" required maxlength="50" value="<%= name %>" size="<%= name.length %>">
        <br><br>

        <textarea name="msg" cols="38" rows="5"><%= msg %></textarea>
        <br><br>

        <button onclick="location.href='/api'">Back</button> &emsp; <button>Submit</button>

    </form>
</body>
</html>