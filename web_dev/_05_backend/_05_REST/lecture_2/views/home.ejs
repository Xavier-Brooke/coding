<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style/home.css">
    <title>home</title>
</head>
<body>
    <h1><i>Welcome to home page &emsp; <form method="get" action="/api/newPost" style="display: inline;"><button>New Post</button></form></i></h1>
    <div id="container">
        <% for(let val of data) {%>
            <div class="cardDiv">

                <h3 class="nameHeading"><i><span class="nameSpan">@<%= val.name %></span></i></h3>
                <p class="msg"><%= val.msg %></p>
                <p class="date"><%= val.date %></p>

                <div class="functionalities">
                    <form method="get" action="/api/<%= val.id %>/details" style="display: inline;"><button>Details</button></form>
                    <form method="get" action="/api/<%= val.id %>/edit" style="display: inline;"><button>Edit</button></form>
                    <form method="post" action="/api/<%= val.id %>/delete?_method=DELETE" style="display: inline;"><button>Delete</button></form>
                </div>

            </div>
        <% } %>
    </div>
</body>
</html>