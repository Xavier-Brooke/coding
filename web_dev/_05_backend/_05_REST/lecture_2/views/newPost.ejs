<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>newPost</title>
</head>
<body>
    <h1><i>Create New Post</i></h1>
    <form method="post" action="/api">
        <label for="name">Enter userName :- </label>
        <input type="text" id="name" name="name" required minlength="3" maxlength="50" placeholder="Enter your userName">
        <br><br>

        <textarea name="msg" cols="38" rows="5" placeholder="Enter your msg here!"></textarea>
        <br><br>

        <button>Submit</button>
    </form>
</body>
</html>