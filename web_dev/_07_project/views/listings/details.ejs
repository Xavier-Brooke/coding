<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Details</title>
</head>
<body>
    <h3>Your Listing Details</h3>
    <form action="">
        <label for="title">Title :- </label>
        <input type="text" id="title" readonly name="listing[title]" value="<%= listing.title %>">
        <br><br>
        <label for="country">Country :- </label>
        <input type="text" id="country" readonly name="listing[country]" value="<%= listing.country %>">
        &emsp;&nbsp;
        <label for="location">Location :- </label>
        <input type="text" id="location" readonly name="listing[location]" value="<%= listing.location %>">
        <br><br>
        <textarea name="listing[description]" readonly cols="65" rows="5"><%= listing.description %></textarea>
    </form>
</body>
</html>