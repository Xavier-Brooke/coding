<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>newListing</title>
</head>
<body>
    <h1>Create New Listing</h1>
    <form method="post" action="/listings">
        <label for="title">Title :- </label>
        <input type="text" id="title" required name="listing[title]" placeholder="Enter title here!">
        <br><br>
        <label for="price">Price :- </label>
        <input type="number" id="price" required name="listing[price]" step="1" min="100" placeholder="Enter price here!">
        <br><br>
        <label for="country">Country :- </label>
        <input type="text" id="country" required name="listing[country]" placeholder="Enter Country here!">
        &emsp;&nbsp;
        <label for="location">Location :- </label>
        <input type="text" id="location" required name="listing[location]" placeholder="Enter location here!">
        <br><br>
        <textarea name="listing[description]" required cols="65" rows="5" placeholder="Enter Description here!"></textarea>
        <br><br>
        <label for="image">Image url :- </label>
        <input type="url" id="image" required name="imgURL" size="150" value="https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTB8fHRyYXZlbHxlbnwwfHwwfHx8MA%3D%3D&auto=format&fit=crop&w=800&q=60">
        <br><br>
        <button type="reset">Reset</button> &emsp; <button>Submit</button>
    </form>
</body>
</html>