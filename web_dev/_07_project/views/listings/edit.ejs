<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
</head>
<body>
    <h3>Edit Your Listing</h3>
    <form method="post" action="/listings/<%= listing.id %>?_method=put">
        <label for="title">Title :- </label>
        <input type="text" id="title" required name="listing[title]" value="<%= listing.title %>">
        <br><br>
        <label for="price">Price :- </label>
        <input type="number" id="price" required name="listing[price]" step="1" min="100" max="9999999" value="<%= listing.price %>">
        <br><br>
        <label for="country">Country :- </label>
        <input type="text" id="country" required name="listing[country]" value="<%= listing.country %>">
        &emsp;&nbsp;
        <label for="location">Location :- </label>
        <input type="text" id="location" required name="listing[location]" value="<%= listing.location %>">
        <br><br>
        <textarea name="listing[description]" required cols="65" rows="5"><%= listing.description %></textarea>
        <br><br>
        <label for="image">Image url :- </label>
        <input type="url" id="image" required name="imgURL" size="150" value="<%= listing.image.url %>">
        <br><br>
        <button type="reset">Reset</button> &emsp; <button>Submit</button> &emsp; 
    </form>
    <br>
    <button type="button" onclick="location.href='/listings'">Home</button>
</body>
</html>